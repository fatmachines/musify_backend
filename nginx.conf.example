# For nginx; get a certificate with certbot (see README).
server {
    listen 80;
    server_name musify.example.com;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A song is fetched from YouTube before it's sent: give it time.
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
